+/// An observable Slint drag: let the scene paint between pointer steps.
+pub(crate) fn dispatch_timed_drag(
+    window: &Window,
+    gesture: &Gesture,
+    done: Box<dyn FnOnce(Result<(), String>)>,
+) {
+    let outcome = (|| -> Result<((f32, f32), (f32, f32), u32), String> {
+        let Gesture::Drag { x, y, target_x, target_y, duration } = gesture else {
+            return Err("CCER: expected a drag gesture".into());
+        };
+        let source = checked_position(window, *x, *y)?;
+        checked_position(window, *target_x, *target_y)?;
+        if !duration.is_finite() || !(0.15..=4.0).contains(duration) {
+            return Err("CCER: invalid drag duration".into());
+        }
+        send(window, WindowEvent::PointerMoved { position: source })?;
+        send(window, WindowEvent::PointerPressed {
+            position: source,
+            button: PointerEventButton::Left,
+        })?;
+        let steps = (*duration * 20.0).ceil() as u32;
+        Ok(((*x, *y), (*target_x, *target_y), steps.max(3)))
+    })();
+    match outcome {
+        Ok((source, target, total)) => drag_step(source, target, 1, total, done),
+        Err(error) => done(Err(error)),
+    }
+}
+
+fn drag_step(
+    source: (f32, f32),
+    target: (f32, f32),
+    index: u32,
+    total: u32,
+    done: Box<dyn FnOnce(Result<(), String>)>,
+) {
+    // A separate Slint timer allows intermediate scene paints.
+    slint::Timer::single_shot(std::time::Duration::from_millis(50), move || {
+        let fraction = index as f32 / total as f32;
+        let position = LogicalPosition::new(
+            source.0 + (target.0 - source.0) * fraction,
+            source.1 + (target.1 - source.1) * fraction,
+        );
+        let mut result = Ok(());
+        Shell::with(|_, app| {
+            let window = app.window();
+            result = send(window, WindowEvent::PointerMoved { position });
+            if index == total || result.is_err() {
+                // Never leave a pressed pointer after a failed step.
+                let release = send(window, WindowEvent::PointerReleased {
+                    position,
+                    button: PointerEventButton::Left,
+                });
+                if result.is_ok() {
+                    result = release;
+                }
+            }
+        });
+        if result.is_ok() && index < total {
+            drag_step(source, target, index + 1, total, done);
+        } else {
+            done(result);
+        }
+    });
+}
