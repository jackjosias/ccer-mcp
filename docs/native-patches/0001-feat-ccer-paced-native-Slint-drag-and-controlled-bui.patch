@@ -51,6 +51,27 @@ fn peer_ok(stream: &UnixStream) -> bool {
     };
     status == 0 && peer.uid == unsafe { libc::geteuid() }
 }
+fn dispatch_gesture(gesture: ccer_input::Gesture) -> Result<(), String> {
+    if matches!(&gesture, ccer_input::Gesture::Drag { .. }) {
+        let (tx, rx) = mpsc::sync_channel(1);
+        slint::invoke_from_event_loop(move || {
+            Shell::with(|_, app| {
+                ccer_input::dispatch_timed_drag(
+                    app.window(),
+                    &gesture,
+                    Box::new(move |result| {
+                        let _ = tx.send(result);
+                    }),
+                );
+            });
+        }).map_err(|error| format!("CCER: drag UI unavailable: {error}"))?;
+        rx.recv_timeout(Duration::from_secs(12))
+            .map_err(|_| "CCER: timed drag did not finish".to_owned())?
+    } else {
+        on_ui(move |window| ccer_input::dispatch(window, &gesture))
+    }
+}
