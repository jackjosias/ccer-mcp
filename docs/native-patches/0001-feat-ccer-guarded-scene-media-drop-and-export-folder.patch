+fn approved_drop_path(raw: &str) -> Result<PathBuf, String> {
+    if raw.is_empty() || raw.len() > 4096 {
+        return Err("CCER: invalid media path".into());
+    }
+    let root = PathBuf::from(
+        std::env::var_os("CCER_INAPP_MEDIA_ROOT")
+            .ok_or("CCER: approved media directory required")?,
+    );
+    let root_meta =
+        fs::symlink_metadata(&root).map_err(|_| "CCER: approved media directory missing")?;
+    if !root.is_absolute() || !root_meta.is_dir() || root_meta.file_type().is_symlink() {
+        return Err("CCER: unsafe approved media directory".into());
+    }
+    let path = PathBuf::from(raw);
+    if !path.is_absolute() {
+        return Err("CCER: media file requires absolute path".into());
+    }
+    let metadata = fs::symlink_metadata(&path).map_err(|_| "CCER: media file unavailable")?;
+    if !metadata.is_file() || metadata.file_type().is_symlink() {
+        return Err("CCER: media path is not a regular file".into());
+    }
+    let allowed_root = root
+        .canonicalize()
+        .map_err(|_| "CCER: media root unavailable")?;
+    let media = path
+        .canonicalize()
+        .map_err(|_| "CCER: media file unavailable")?;
+    if !media.starts_with(&allowed_root) {
+        return Err("CCER: media file outside approved directory".into());
+    }
+    let extension = media
+        .extension()
+        .and_then(|v| v.to_str())
+        .unwrap_or("")
+        .to_ascii_lowercase();
+    if ![
+        "mp4", "mov", "mkv", "webm", "avi", "m4v", "mp3", "wav", "aac", "m4a", "flac", "ogg",
+        "png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff",
+    ]
+    .contains(&extension.as_str())
+    {
+        return Err("CCER: unsupported media extension".into());
+    }
+    Ok(media)
+}
+
+fn approved_export_folder() -> Result<String, String> {
+    let path = PathBuf::from(
+        std::env::var_os("CCER_INAPP_EXPORT_ROOT")
+            .ok_or("CCER: approved output directory required")?,
+    );
+    let metadata = fs::symlink_metadata(&path).map_err(|_| "CCER: output directory unavailable")?;
+    if !path.is_absolute() || !metadata.is_dir() || metadata.file_type().is_symlink() {
+        return Err("CCER: unsafe output directory".into());
+    }
+    let resolved = path
+        .canonicalize()
+        .map_err(|_| "CCER: output directory unavailable")?;
+    Ok(resolved
+        .to_str()
+        .ok_or("CCER: output directory encoding unsupported")?
+        .to_owned())
+}
