+/// Run an application gesture on the Slint thread without nesting Shell::with.
+fn on_app<T: Send + 'static>(
+    f: impl FnOnce() -> Result<T, String> + Send + 'static,
+) -> Result<T, String> {
+    let (tx, rx) = mpsc::sync_channel(1);
+    slint::invoke_from_event_loop(move || {
+        let _ = tx.send(f());
+    })
+    .map_err(|e| format!("CCER: application UI unavailable: {e}"))?;
+    rx.recv_timeout(Duration::from_secs(12))
+        .map_err(|_| "CCER: application action timed out".to_owned())?
+}
 fn peer_ok(stream: &UnixStream) -> bool {
     let mut peer: libc::ucred = unsafe { std::mem::zeroed() };
     let mut size = std::mem::size_of::<libc::ucred>() as libc::socklen_t;
